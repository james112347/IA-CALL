# ============================================
# IA-CALL SaaS Platform - Configurazione
# ============================================
# Queste sono le API key MASTER della piattaforma.
# I tuoi clienti NON devono registrarsi su nessun servizio.
# ============================================

# === JWT Secret (cambia con una stringa random lunga) ===
JWT_SECRET=cambia-questa-stringa-con-qualcosa-di-sicuro

# === Twilio (account master della piattaforma) ===
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# === Groq (AI - chiave unica della piattaforma) ===
GROQ_API_KEY=your_groq_api_key

# === ElevenLabs (TTS - account Pro della piattaforma) ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# === Supabase (database unico multi-tenant) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# === Server ===
PORT=3000
BASE_URL=https://your-domain.com
